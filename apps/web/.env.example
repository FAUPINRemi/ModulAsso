# Valeurs factices. Les vrais secrets ne vont JAMAIS ici.
# En développement : copier ce fichier en .env.local (ignoré par Git).
# Règle : aucune variable NEXT_PUBLIC_* ne contient un secret.

# Adresse de l'API sur le réseau Docker interne (jamais appelée par le navigateur)
API_URL=http://api:8080

# Mode démo : permet d'entrer sans API. À mettre à false dès que la connexion est branchée.
DEMO_MODE=true
